{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "kiosk web",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/run_web.ps1"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "dart",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Launching",
          "endsPattern": "Flutter run key commands"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
